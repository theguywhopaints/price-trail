# ============================================
# PriceTrail — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your keys.
# The app works WITHOUT any keys (demo mode with mock data).

# ── GROQ (AI-powered product search) ──────
# Get your key at https://console.groq.com
# Free tier: generous limits, no credit card needed
# Enables: AI search for any product with Australian retail prices
GROQ_API_KEY=

# ── SERPER.DEV (Live Google Shopping scrape) ─
# Sign up free at https://serper.dev
# Free tier: 2,500 searches
# Enables: real-time scraped prices (used as supplement to Groq)
SERPER_API_KEY=
